# ----------------------------------------------------------------------------
# Discord webhook URLs. One per channel. Copy this file to .env and fill in.
#
# These URLs are effectively passwords: anyone holding one can post anything
# to that channel. .env is git-ignored. Never paste a webhook URL into chat,
# a screenshot, or a public repo.
#
# DEPLOYED runs (GitHub Actions) do NOT use this file. Set each value as a
# repository Secret instead (Settings -> Secrets and variables -> Actions).
# This file is only for running the bot locally.
# ----------------------------------------------------------------------------

NEWS_WEBHOOK_URL=
WEATHER_WEBHOOK_URL=
GOVERNMENT_WEBHOOK_URL=
STATUS_WEBHOOK_URL=

# Optional. Path to the SQLite state file. Defaults to state.db in the repo root.
# STATE_DB_PATH=state.db

# Optional. Path to the local logfile. Defaults to feed-bot.log.
# LOG_PATH=feed-bot.log
